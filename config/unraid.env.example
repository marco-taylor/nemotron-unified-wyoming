# Docker-Compose-Beispiel. MODEL_DIR ist hier der Hostpfad; im Container /models.
IMAGE=ghcr.io/marco-taylor/nemotron-unified-wyoming:latest
PUBLISH_ADDRESS=0.0.0.0
HOST_PORT=10310

# Bind-Adresse: IPv4 oder IPv6 im Container; für Docker-Bridge 0.0.0.0 verwenden.
WYOMING_HOST=0.0.0.0

# Wyoming-Port im Container: 1 bis 65535; Container-Portabbildung bei Änderung ebenfalls anpassen.
WYOMING_PORT=10300

# Sprache: Deutsch (de); andere Sprachen werden in diesem Server abgewiesen.
LANGUAGE=de

# Inferenzgerät: Dieses Image unterstützt ausschließlich CPU; GPU/CUDA werden abgewiesen.
STT_DEVICE=cpu

# Modellverzeichnis im Container: Basis für relative Modellpfade; muss zum persistenten Modellmount passen; RW nur zur Initialisierung nötig.
MODEL_DIR=/mnt/user/appdata/nemotron-unified-wyoming/models/L37-runtime

# Encoderpfad (optional): Leer: encoder.int8.onnx unter MODEL_DIR; sonst relativer oder absoluter Containerpfad.
ENCODER_PATH=

# Decoderpfad (optional): Leer: decoder.onnx unter MODEL_DIR; alle Dateien aus demselben Export verwenden.
DECODER_PATH=

# Joinerpfad (optional): Leer: joiner.onnx unter MODEL_DIR; relativer oder absoluter Containerpfad.
JOINER_PATH=

# Tokenizerpfad (optional): Leer: tokens.txt unter MODEL_DIR; passend zum exportierten Modell.
TOKENS_PATH=

# ORT-Inferenzthreads: 1, 2 oder 4; für Intel N100 werden 2 empfohlen. Kein hartes Prozess-Threadlimit.
THREADS=2

# Maximale Audiodauer: 1 bis 120 Sekunden pro Anfrage; Überschreitung verwirft die Sitzung.
MAX_AUDIO_SECONDS=120

# Maximale Audio-Payload: Gerade Zahl von 640 bis 320000 Byte; Grenze vor der Payload-Allokation.
MAX_AUDIO_CHUNK_BYTES=320000

# Maximale Verbindungen: 1 bis 32; begrenzt Sitzungen und Queue. Native Inferenz bleibt serialisiert.
MAX_CONNECTIONS=8

# Client-Timeout: 1 bis 300 Sekunden; absolute Framefrist und Socket-Schreibtimeout.
CLIENT_TIMEOUT_SECONDS=30

# Native Zuführung in Millisekunden: 10 bis 560 ms; teilt empfangene Chunks maximal so groß auf. Ändert nicht L37-Kontext oder algorithmische Latenz.
INFERENCE_CHUNK_MS=20

# Protokollierungsstufe: error, warn, info oder debug; Großschreibung erlaubt. Betrifft Rust-Logs, nicht native ORT-Fehler.
LOG_LEVEL=info

# Erkannte Texte protokollieren: true oder false; nur bei info/debug. Enthält möglicherweise persönliche Sprachinhalte.
LOG_TRANSCRIPTS=false

# Unraid-Identität; kurzzeitiger Bootstrap, Server danach ohne Root
PUID=99
PGID=100
